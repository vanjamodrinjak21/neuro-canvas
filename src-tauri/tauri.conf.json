{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroCanvas",
  "identifier": "com.neurocanvas.app",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "bash scripts/tauri-dev.sh",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/fetch-onnx-model.mjs && npm run generate && node scripts/post-generate.cjs",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NeuroCanvas",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob: tauri: ipc:; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://api.fontshare.com data:; img-src 'self' https: data: blob: tauri:; connect-src 'self' https: wss: tauri: ipc:",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": [
      "resources/models/nomic-embed-text-v1.5/model_quantized.onnx",
      "resources/models/nomic-embed-text-v1.5/tokenizer.json",
      "resources/models/nomic-embed-text-v1.5/tokenizer_config.json",
      "resources/models/nomic-embed-text-v1.5/special_tokens_map.json",
      "resources/models/nomic-embed-text-v1.5/config.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI-powered mind mapping for students",
    "longDescription": "NeuroCanvas is an AI-powered mind map builder for students — a visual drag-and-drop tool where AI helps you think deeper, find connections, and organize ideas.",
    "copyright": "2026 Vanja Modrinjak",
    "publisher": "NeuroCanvas",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.neuro-canvas.com/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGMDkwRDVBMEM0QkRDM0UKUldRKzNFc01XZzBKLzlRaEMwWGNzMnU4UlBINHVZcys3S092d2lXRW1Ib3dlL1JWTUtKYkN2U2sK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "neurocanvas",
          "com.googleusercontent.apps.1025021574887-effk89v1d8s52cjgc4m7mi4nmipruk6c"
        ]
      },
      "mobile": [
        { "host": "neuro-canvas.com", "pathPrefix": ["/auth"] }
      ]
    }
  }
}
